# ── WHS Wreath Fundraiser — environment ──────────────────────────────
# Copy to .env.local and fill in before sharing the link.

# Contact + organizer notifications. Order emails are addressed here.
ORGANIZER_EMAIL=2010436@apps.nsd.org
# Shown publicly as the contact address.
NEXT_PUBLIC_CONTACT_EMAIL=2010436@apps.nsd.org

# Simple token gate for /admin (organizer order list). Pick a long random
# string; organizers open /admin?token=YOUR_TOKEN.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional: transactional email via Resend (https://resend.com).
# Without these, orders still save locally + to data/orders.json, and the
# confirmation page gives a one-click "email the boosters" fallback.
# Never commit real keys.
RESEND_API_KEY=
EMAIL_FROM=WHS Music Boosters <fundraiser@woodinville-music.example>
EMAIL_REPLY_TO=2010436@apps.nsd.org

# Optional PayPal: paste the boosters' public PayPal.me link if the QR
# should also work as a tappable link. QR image itself lives at
# public/paypal-qr.svg — replace with the official QR scan file.
NEXT_PUBLIC_PAYPAL_LINK=

# Public site URL (used for Open Graph + QR page links). Set on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
